# ChatScan Block Explorer configuration.
# Every value below is a default - the explorer runs with none of them set.

# --- HTTP -------------------------------------------------------------------
CHATSCAN_HOST=0.0.0.0
CHATSCAN_PORT=3000

# --- Chain backend ----------------------------------------------------------
# cdci  - index the CDCI X11 blockchain (github.com/Centraldb/CDCI) over RPC
# local - self-contained development chain, for working without a node
CHATSCAN_CHAIN_BACKEND=local

# --- CDCI node (used when CHATSCAN_CHAIN_BACKEND=cdci) ----------------------
# See docs/CDCI.md. Start centraldatabased with -txindex=1, which anchor lookups
# depend on. Leave the RPC user empty to use the node's own __cookie__ file.
CDCI_NETWORK=main
# CDCI_RPC_URL=http://127.0.0.1:13431/
# CDCI_RPC_USER=
# CDCI_RPC_PASSWORD=
# CDCI_RPC_COOKIE_FILE=/home/you/.centraldatabasecore/.cookie
CDCI_RPC_TIMEOUT_MS=5000

# client - the CrypterChat client publishes its own anchor and submits the txid
# wallet - ChatScan publishes anchors from the node's wallet (spends coins)
CDCI_ANCHOR_MODE=client
CDCI_REQUIRE_ANCHOR=true
CDCI_CONFIRMATIONS_FOR_FINALITY=6
CDCI_ANCHOR_POLL_MS=30000

# --- Network identity -------------------------------------------------------
# Left empty these follow the backend: cdci-main / cdci:main in cdci mode,
# x11-local / x11:local otherwise. The chain id is mixed into record hashes and
# anchor commitments, so changing it changes both.
# CHATSCAN_NETWORK=
# CHATSCAN_CHAIN_ID=

# --- Storage ----------------------------------------------------------------
# Append-only chain log location. Set CHATSCAN_PERSIST=false for an in-memory node.
CHATSCAN_DATA_DIR=./data
CHATSCAN_PERSIST=true

# --- Sealing (local backend only) --------------------------------------------
CHATSCAN_BLOCK_INTERVAL_MS=15000
CHATSCAN_MAX_RECORDS_PER_BLOCK=64
CHATSCAN_DIFFICULTY_NIBBLES=2
CHATSCAN_SEALER_ENABLED=true
CHATSCAN_SEALED_BY=chatscan-local-sealer

# --- Ingest -----------------------------------------------------------------
# Leave CHATSCAN_INGEST_KEYS empty for open local ingest. In production set one
# comma-separated key per CrypterChat node and keep them out of version control.
CHATSCAN_INGEST_KEYS=
CHATSCAN_INGEST_RATE_PER_MINUTE=600
CHATSCAN_MAX_REQUEST_BYTES=16384
CHATSCAN_MAX_CIPHERTEXT_BYTES=4194304

# --- Presentation -----------------------------------------------------------
CHATSCAN_FEE_QUOTE_USD=21.546
CHATSCAN_LOG_LEVEL=info
