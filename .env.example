# Netlify API deploy (never commit real values).
# Token: https://app.netlify.com/user/applications#personal-access-tokens
# Site ID: Site configuration → General → Site details
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=2d2bad4f-7244-484a-8e3f-608ab487a382

# Optional: rebuild from Git instead of uploading docs/
# Site configuration → Build & deploy → Build hooks
NETLIFY_DEPLOY_HOOK=

# ChatScan backend (optional). Default is the local sealer daemon.
# github.com/Centraldb/CDCI and Daemon are not public; set these when a
# centraldatabased node is available.
# CHATSCAN_CHAIN_BACKEND=local
# CHATSCAN_DATA_DIR=
# CDCI_RPC_URL=
# CDCI_RPC_USER=
# CDCI_RPC_PASSWORD=
